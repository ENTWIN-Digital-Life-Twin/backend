# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dlt_auth
DB_USERNAME=dlt
DB_PASSWORD=changeme

# JWT — must match across auth-service, planning, wellness, notification, and api-gateway
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# CORS — comma-separated explicit origins. Do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# API Gateway
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://localhost:8081
PLANNING_SERVICE_URL=http://localhost:8082
WELLNESS_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
AI_SERVICE_URL=http://localhost:8090
# Used by the gateway (public /api/v1/ai/**) and by planning/wellness dashboard clients.
GATEWAY_AUTH_RATE_LIMIT_REQUESTS=20
GATEWAY_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Docker Compose defaults for the gateway container use service DNS names, e.g.:
# AUTH_SERVICE_URL=http://auth-service:8081

# Planning service DB (same Postgres server as auth)
PLANNING_DB_NAME=dlt_planning
PLANNING_DEFAULT_TIMEZONE=Africa/Casablanca
PLANNING_DAY_START=08:00
PLANNING_DAY_END=23:00

# Wellness service DB (same Postgres server as auth)
WELLNESS_DB_NAME=dlt_wellness
WELLNESS_DEFAULT_TIMEZONE=Africa/Casablanca
# Fallback until user water goal is synced from auth-service preferences
WELLNESS_DEFAULT_WATER_GOAL_ML=2000

# Notification service DB (same Postgres server as auth)
NOTIFICATION_DB_NAME=dlt_notification
NOTIFICATION_SCHEDULER_FIXED_DELAY_MS=60000

# Optional (per-service listen port when running a module directly)
SERVER_PORT=8081
